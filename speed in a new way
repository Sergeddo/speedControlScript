from math import sqrt

def tension(tension1, tension2):
    #from powerplantUnit
    dTension=tension2-tension1
    tension=tension2
    return(dTension, tension)

def frequency(frequency1, frequency2):
    #from metricControlInterfaceUnit
    dFrequency=frequency2-frequency1
    frequency=frequency2
    return(dFrequency, frequency)

def mass(mass1, mass2):
    #from vesselSpecifics
    dMass=mass2-mass1
    mass=mass2
    return(dMass, mass)

def impedance(impedance1, impedance2):
    #from metricControlInterfaceUnit
    dImpedance=impedance2-impedance1
    impedance=impedance2
    return(dImpedance, impedance)

def speed(tension, frequency, mass, impedance):
    #from speedControlUnit
    V=tension
    f=frequency
    m=mass
    Z=impedance
    if(V==0 or f==0 or m==0 or Z==0):
        pass
    else:
        ν=V/sqrt(f*m*Z)
        return(ν, V, f, m, Z)

def deltaSpeed(dTension, dFrequency, dMass, dImpedance):
    #from nominalSpeedControlUnit
    if(dTension==0 or dFrequency==0 or dMass==0 or dImpedance==0):
        pass
    else:
        dV=dTension
        df=dFrequency
        dm=dMass
        dZ=dImpedance
        dν=dV/sqrt(df*dm*dZ)
        return(dν)

def speedDivergence(V, f, m, Z):
    #from nominalSpeedControlUnit
    if(V==0 or f==0 or m==0 or Z==0):
        pass
    else:
        pdV=1/sqrt(f*m*Z)
        pdf=-V/(2*f*sqrt(f*m*Z))
        pdm=-V/(2*m*sqrt(f*m*Z))
        pdZ=-V/(2*Z*sqrt(f*m*Z))
        td=pdV+pdf+pdm+pdZ
        return(td)
