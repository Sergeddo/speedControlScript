def tension(tension1, tension2):
    #from the powerplant unit
    deltaTension=tension2-tension1
    tension=tension2
    return(deltaTension, tension)
    pass

def frequency(frequency1, frequency2):
    #from the controls interface
    deltaFrequency=frequency2-frequency1
    frequency=frequency2
    return(deltaFrequency, frequency)
    pass

def mass(mass1, mass2):
    #from the vessel's specifics
    deltaMass=mass2-mass1
    mass=mass2
    return(deltaMass, mass)
    pass

def impedance(impedance1, impedance2):
    #from the metric control interface unit
    deltaImpedance=impedance2-impedance1
    impedance=impedance2
    return(deltaImpedance, impedance)
    pass

def speed():
    V=tension
    f=frequency
    m=mass
    Z=impedance
    ν=V/sqrt(f*m*Z)
    return(ν, V, f, m, Z)
