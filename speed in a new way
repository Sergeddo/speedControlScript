from math import sqrt

def tension(tension1, tension2):
    #from the powerplant unit
    dTension=tension2-tension1
    tension=tension2
    return(dTension, tension)

def frequency(frequency1, frequency2):
    #from the controls interface
    dFrequency=frequency2-frequency1
    frequency=frequency2
    return(dFrequency, frequency)

def mass(mass1, mass2):
    #from the vessel's specifics
    dMass=mass2-mass1
    mass=mass2
    return(dMass, mass)

def impedance(impedance1, impedance2):
    #from the metric control interface unit
    dImpedance=impedance2-impedance1
    impedance=impedance2
    return(dImpedance, impedance)

def speed():
    V=tension
    f=frequency
    m=mass
    Z=impedance
    if(V==0 or f==0 or m==0 or Z==0):
        pass
    else:
        ν=V/sqrt(f*m*Z)
        return(ν, V, f, m, Z)

def deltaSpeed():
    if(dTension==0 or dFrequency==0 or dMass==0 or dImpedance==0):
        pass
    else:
        dV=deltaTension
        df=deltaFrequency
        dm=deltaMass
        dZ=deltaImpedance
        dν=dV/sqrt(df*dm*dZ)
        return(deltaν)

def speedDivergence():
    d1=1/sqrt(f*m*Z)
    d2=-V/(2*f*sqrt(f*m*Z))
    d3=-V/(2*m*sqrt(f*m*Z))
    d4=-V/(2*Z*sqrt(f*m*Z))
    td=d1+d2+d3+d4
    return(td)
