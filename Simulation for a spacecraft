def frequency(measure1, measure2):
    #from the controls interface
    deltaFrequency=measure2-measure1
    frequency=measure2
    return(deltaFrequency, frequency)
    pass

def mass(measure1, measure2):
    #from the vessel's specifics
    deltaMass=measure2-measure1
    mass=measure2
    return(deltaMass, mass)
    pass

def impedance(measure1, measure2):
    #from the metric control interface unit
    deltaImpedance=measure2-measure1
    impedance=measure2
    return(deltaImpedance, impedance)
    pass

def fsdSpeed():
    V=tension
    f=frequency
    m=mass
    Z=impedance
    ν=V/sqrt(f*m*Z)
    return(ν, V, f, m, Z)
    pass

def fsdAcceleration():
    V=deltaTension
    f=deltaFrequency
    m=deltaMass
    Z=deltaImpedance
    deltaν=V/sqrt(f*m*Z)
    return(deltaν)
    pass

def fsdSpeedDivergence():
    d1=1/sqrt(f*m*Z)
    d2=-V/(2*f*sqrt(f*m*Z))
    d3=-V/(2*m*sqrt(f*m*Z))
    d4=-V/(2*Z*sqrt(f*m*Z))
    td=d1+d2+d3+d4
    return(td)
